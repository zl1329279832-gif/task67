	<build>
	<!-- 项目访问名称 -->
		<finalName>ssmu8xr0</finalName>
		<!-- 资源过滤：Maven profile 属性可覆盖 config.properties 中的值 -->
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
				<includes>
					<include>**/*.properties</include>
					<include>**/*.xml</include>
					<include>**/*.yml</include>
				</includes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
				<excludes>
					<exclude>**/*.properties</exclude>
					<exclude>**/*.xml</exclude>
					<exclude>**/*.yml</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<!-- JDK 编译 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
					<encoding>UTF-8</encoding>
				</configuration>
			</plugin>
			<!-- WAR 打包 -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.3.2</version>
				<configuration>
					<failOnMissingWebXml>false</failOnMissingWebXml>
					<warName>ssmu8xr0</warName>
					<packagingExcludes>
						webapp/admin/node_modules/**,
						webapp/admin/src/**,
						webapp/admin/public/**,
						webapp/admin/*.bat,
						webapp/admin/package.json,
						webapp/admin/package-lock.json,
						webapp/admin/vue.config.js,
						webapp/admin/.env*,
						webapp/admin/babel.config.js,
						webapp/admin/.browserslistrc,
						webapp/admin/.eslintrc.js
					</packagingExcludes>
				</configuration>
			</plugin>
			<!-- 前端自动构建（Node + npm） -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>1.12.1</version>
				<configuration>
					<workingDirectory>${project.basedir}/src/main/webapp/admin</workingDirectory>
					<installDirectory>${project.build.directory}/node</installDirectory>
					<skip>${skip.frontend}</skip>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<goals><goal>install-node-and-npm</goal></goals>
						<phase>generate-resources</phase>
						<configuration>
							<nodeVersion>${node.version}</nodeVersion>
							<npmVersion>${npm.version}</npmVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm-install</id>
						<goals><goal>npm</goal></goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>install --legacy-peer-deps</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm-build</id>
						<goals><goal>npm</goal></goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- ===== 数据库 Profile ===== -->
		<profile>
			<id>mysql</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<db.profile>mysql</db.profile>
			</properties>
		</profile>
		<profile>
			<id>sqlserver</id>
			<properties>
				<db.profile>sqlserver</db.profile>
			</properties>
		</profile>

		<!-- ===== 跳过前端构建 ===== -->
		<profile>
			<id>skip-frontend</id>
			<properties>
				<skip.frontend>true</skip.frontend>
			</properties>
		</profile>

		<!-- ===== JDK 11 兼容（需 javax 模块补充） ===== -->
		<profile>
			<id>jdk11</id>
			<properties>
				<java.version>11</java.version>
			</properties>
			<dependencies>
				<!-- JDK 11 移除了 javax.xml.bind -->
				<dependency>
					<groupId>javax.xml.bind</groupId>
					<artifactId>jaxb-api</artifactId>
					<version>2.3.1</version>
				</dependency>
				<dependency>
					<groupId>org.glassfish.jaxb</groupId>
					<artifactId>jaxb-runtime</artifactId>
					<version>2.3.1</version>
				</dependency>
				<!-- JDK 11 移除了 javax.annotation -->
				<dependency>
					<groupId>javax.annotation</groupId>
					<artifactId>javax.annotation-api</artifactId>
					<version>1.3.2</version>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
